# Copy to .streamlit/secrets.toml and replace every placeholder locally.
# Do not commit .streamlit/secrets.toml.
[paths]
tariff_db = "data/tariff.db"

[mongodb]
uri = "YOUR_VALUE_HERE"

[google]
api_key = "YOUR_VALUE_HERE"

# DeepL translation — server-side only, never sent to the browser.
# Both shapes work; the FIRST non-empty source wins:
#   1. env DEEPL_API_KEYS   2. env DEEPL_API_KEY
#   3. [deepl].api_keys     4. [deepl].api_key
[deepl]
api_key = "YOUR_VALUE_HERE"
# api_keys = ["KEY_01", "KEY_02"]

# LOGI_SHIPMENT_DOCUMENTS_DRIVE_01 — shipment attachments (bytes on Google
# Drive, metadata in MongoDB). Server-side only: share ONE Drive folder with the
# service account's client_email, then set its id here. A JSON string is the
# preferred shape; a TOML table works too. Never commit the real values.
[google_drive]
root_folder_id = "YOUR_VALUE_HERE"
service_account_json = "YOUR_VALUE_HERE"
