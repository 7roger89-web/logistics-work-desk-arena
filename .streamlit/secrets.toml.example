# Copy to .streamlit/secrets.toml and replace every placeholder locally.
# Do not commit .streamlit/secrets.toml.
# Section/key names below are exactly what core/config.py reads. Environment
# variables win over this file; use ONE channel per setting.
# Verify what was loaded (without printing secrets): python scripts/check_config.py

# DISPLAY_COMPANY_NAME — operating/display brand on ordinary surfaces (browser
# tab title, login card, shell header). Optional; default is already
# "Trường Thành Logistics". DISPLAY identity ONLY — the legal company identity
# used by contracts/payments/PXK/GNT documents keeps deriving from the
# authority_companies master in MongoDB. Env override: DISPLAY_COMPANY_NAME.
[display]
company_name = "Trường Thành Logistics"

# Login is fail-closed when this section is absent. Keep true for deployed use.
# Set false only for an intentional local/dev single-user session.
[auth]
required = true

# G1 customer Google OIDC — Streamlit's built-in st.login("google") reads these
# keys directly from secrets.toml (NOT from .env). Replace placeholders only in
# the gitignored .streamlit/secrets.toml. Never commit real values.
# redirect_uri must be the app's absolute URL ending in /oauth2callback, and
# must be registered as an authorised redirect URI in Google Cloud.
redirect_uri = "YOUR_VALUE_HERE/oauth2callback"
# Generate >=32 random bytes locally, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
cookie_secret = "YOUR_VALUE_HERE"

[auth.google]
client_id = "YOUR_VALUE_HERE"
client_secret = "YOUR_VALUE_HERE"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# MongoDB — section is [mongo] (env: MONGO_URI / MONGO_DB_NAME). Without a URI
# the UI runs on the in-memory mongomock staging transport only (README
# section 7). With a real URI, "database" is REQUIRED explicitly; there is no
# default and the app fails closed when it is missing or not allow-listed.
[mongo]
uri = "YOUR_VALUE_HERE"
database = "YOUR_DB_NAME_HERE"
# Optional allow-list; omitted uses the built-in default list in core/config.py.
# allowed_databases = ["logistics_workdesk_logc14"]
# Owner-only release gate for the production database. Keep false unless the
# Owner explicitly opens the release gate for this deployment.
release_mode = false

# DEV (default) | STAGING | PREVIEW | PRODUCTION. STAGING/PREVIEW are blocked
# from the production database; PRODUCTION requires release_mode = true.
[env]
identity = "DEV"

[paths]
tariff_db = "data/tariff.db"
# Optional local template/reference files (machine-specific; never committed).
# gnt_template = "GNT_MAU.xlsx"
# treasury_file = "MA_NGAN_SACH.xlsx"
# Runtime directory of legal document templates. Empty/omitted means document
# generation reports its owner gate instead of generating from a wrong file.
# docgen_templates = "/path/to/docgen-templates"

# gridfs (default, uses your MongoDB) | drive_shared | drive_oauth.
# Optional non-secret selector; omitted means gridfs. The drive backends are
# explicit opt-ins and never become a silent fallback.
[attachments]
storage_backend = "gridfs"

# Gemini — section is [gemini] (env: GEMINI_API_KEY / GEMINI_KEYS).
[gemini]
api_key = "YOUR_VALUE_HERE"
# api_keys = ["KEY_01", "KEY_02"]
# model = "gemini-3.6-flash"   # optional; pinned default lives in core/config.py

# DeepL translation — server-side only, never sent to the browser.
# Both shapes work; the FIRST non-empty source wins:
#   1. env DEEPL_API_KEYS   2. env DEEPL_API_KEY
#   3. [deepl].api_keys     4. [deepl].api_key
[deepl]
api_key = "YOUR_VALUE_HERE"
# api_keys = ["KEY_01", "KEY_02"]

# Telegram notifications/bot (env: TELEGRAM_TOKEN / TELEGRAM_CHAT_ID).
[telegram]
token = "YOUR_VALUE_HERE"
chat_id = "YOUR_VALUE_HERE"

# LOGI_SHIPMENT_DOCUMENTS_DRIVE_REINTEGRATE_02 — shipment attachments (bytes on
# Google Drive, metadata in MongoDB). Only used by the drive_shared /
# drive_oauth backends above. Server-side only. Never commit real values.
# SERVICE_ACCOUNT_STORAGE_MODE=SHARED_DRIVE_ONLY: service accounts have no Drive
# storage quota and cannot own files, so root_folder_id must be a WRITABLE
# FOLDER INSIDE A GOOGLE WORKSPACE SHARED DRIVE, with the service account's
# client_email granted write permission on that Shared Drive/folder. A normal My
# Drive folder shared with the service account is UNSUPPORTED for this mode.
# Without an available Shared Drive: LIVE_DRIVE_VERIFICATION=BLOCKED.
# A JSON string is the preferred service_account_json shape; a TOML table works
# too.
[google_drive]
root_folder_id = "YOUR_VALUE_HERE"
service_account_json = "YOUR_VALUE_HERE"
# drive_oauth mode instead uses this OAuth triple (same root-folder rule):
# oauth_client_id = "YOUR_VALUE_HERE"
# oauth_client_secret = "YOUR_VALUE_HERE"
# oauth_refresh_token = "YOUR_VALUE_HERE"
