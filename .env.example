# Copy to .env and supply local values. Never commit .env.
MONGODB_URI=YOUR_VALUE_HERE
GEMINI_API_KEY=YOUR_VALUE_HERE
# DeepL accepts a JSON list or comma-separated list; keep real keys local only.
DEEPL_API_KEYS=["KEY_01","KEY_02"]
# A single key also works via DEEPL_API_KEY (singular). Precedence:
# DEEPL_API_KEYS env > DEEPL_API_KEY env > [deepl].api_keys > [deepl].api_key.
DEEPL_API_KEY=YOUR_VALUE_HERE
TELEGRAM_TOKEN=YOUR_VALUE_HERE
TELEGRAM_CHAT_ID=YOUR_VALUE_HERE
TARIFF_DB_PATH=data/tariff.db
# Google Drive attachment store (LOGI_SHIPMENT_DOCUMENTS_DRIVE_01) — server-side
# only, never exposed to the browser. Share ONE Owner-controlled Drive folder
# with the service account's client_email, then set that folder id below.
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_VALUE_HERE
GOOGLE_SERVICE_ACCOUNT_JSON=YOUR_VALUE_HERE
