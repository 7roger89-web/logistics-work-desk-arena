# Copy to .env and supply local values. Never commit .env.
# Variable names below are exactly what core/config.py reads. Environment
# variables win over .streamlit/secrets.toml; use ONE channel per setting.
# Verify what was loaded (without printing secrets): python scripts/check_config.py

# --- Auth & display -----------------------------------------------------------
# Login is fail-closed by default. Set false ONLY for an intentional local/dev
# single-user session; production should keep this true.
AUTH_REQUIRED=true
# Optional display brand on ordinary surfaces (tab title, login card, header).
# DISPLAY identity only; the legal company identity on contracts/payments
# documents always derives from the authority_companies master in MongoDB.
# DISPLAY_COMPANY_NAME=Trường Thành Logistics

# --- MongoDB ------------------------------------------------------------------
# Variable name is MONGO_URI. Without it the UI runs on the in-memory mongomock
# staging transport only (see README section 7).
MONGO_URI=YOUR_VALUE_HERE
# Legacy alias (since 2026-10-26): MONGODB_URI is still accepted with a one-time
# DeprecationWarning; MONGO_URI always wins when both are set. Prefer MONGO_URI.
# MONGODB_URI=YOUR_VALUE_HERE
# Explicit database name is REQUIRED with a real URI; there is no default and
# the app fails closed when it is missing or not allow-listed.
MONGO_DB_NAME=YOUR_DB_NAME_HERE
# Optional allow-list (JSON list or comma-separated). Empty/omitted uses the
# built-in default list in core/config.py.
# MONGO_ALLOWED_DB_NAMES=["logistics_workdesk_logc14"]
# DEV (default) | STAGING | PREVIEW | PRODUCTION. STAGING/PREVIEW are blocked
# from the production database; PRODUCTION requires MONGO_RELEASE_MODE=true.
ENV_IDENTITY=DEV
# Owner-only release gate for the production database. Keep false unless the
# Owner explicitly opens the release gate for this deployment.
MONGO_RELEASE_MODE=false

# --- AI / translation / bot (server-side only) --------------------------------
GEMINI_API_KEY=YOUR_VALUE_HERE
# Multiple Gemini keys (optional; JSON list or comma-separated). A single
# GEMINI_API_KEY above takes precedence and is merged first.
# GEMINI_KEYS=["KEY_01","KEY_02"]
# Optional; defaults to the model pinned in core/config.py.
# GEMINI_MODEL=gemini-3.6-flash
# DeepL accepts a JSON list or comma-separated list; keep real keys local only.
DEEPL_API_KEYS=["KEY_01","KEY_02"]
# A single key also works via DEEPL_API_KEY (singular). Precedence:
# DEEPL_API_KEYS env > DEEPL_API_KEY env > [deepl].api_keys > [deepl].api_key.
DEEPL_API_KEY=YOUR_VALUE_HERE
TELEGRAM_TOKEN=YOUR_VALUE_HERE
TELEGRAM_CHAT_ID=YOUR_VALUE_HERE

# --- Local paths ---------------------------------------------------------------
# Create an empty compatible tariff DB with:
#   python scripts/initialize_tariff_db.py --database data/tariff.db
# Never commit a populated tariff database.
TARIFF_DB_PATH=data/tariff.db
# Optional local template/reference files (machine-specific; never committed).
# GNT_TEMPLATE_PATH=GNT_MAU.xlsx
# TREASURY_FILE_PATH=MA_NGAN_SACH.xlsx
# Runtime directory of legal document templates. Empty means document
# generation reports its owner gate instead of generating from a wrong file.
# DOCGEN_TEMPLATE_DIR=/path/to/docgen-templates

# --- Shipment attachments -------------------------------------------------------
# gridfs (default) uses the MongoDB you already run. drive_shared / drive_oauth
# are explicit opt-ins; unknown values fail closed. This is not a secret.
ATTACHMENT_STORAGE_BACKEND=gridfs
# Google Drive attachment store (only for drive_shared / drive_oauth) —
# server-side only, never exposed to the browser.
# SERVICE_ACCOUNT_STORAGE_MODE=SHARED_DRIVE_ONLY: service accounts have no Drive
# storage quota and cannot own files, so GOOGLE_DRIVE_ROOT_FOLDER_ID must be a
# WRITABLE FOLDER INSIDE A GOOGLE WORKSPACE SHARED DRIVE (the service account's
# client_email needs write permission on that Shared Drive/folder). A normal My
# Drive folder shared with the service account is UNSUPPORTED for this mode.
# Without an available Shared Drive: LIVE_DRIVE_VERIFICATION=BLOCKED.
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_VALUE_HERE
GOOGLE_SERVICE_ACCOUNT_JSON=YOUR_VALUE_HERE
# drive_oauth mode instead uses this OAuth triple (same root-folder rule):
# GOOGLE_DRIVE_OAUTH_CLIENT_ID=YOUR_VALUE_HERE
# GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=YOUR_VALUE_HERE
# GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=YOUR_VALUE_HERE

# Optional: explicit secrets.toml location for CLI scripts.
# LOGISTICS_PRO_SECRETS_FILE=/path/to/secrets.toml
