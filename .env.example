# Copy to .env and supply local values. Never commit .env.
# Login is fail-closed by default. Set false ONLY for an intentional local/dev
# single-user session; production should keep this true.
AUTH_REQUIRED=true
MONGODB_URI=YOUR_VALUE_HERE
GEMINI_API_KEY=YOUR_VALUE_HERE
# DeepL accepts a JSON list or comma-separated list; keep real keys local only.
DEEPL_API_KEYS=["KEY_01","KEY_02"]
# A single key also works via DEEPL_API_KEY (singular). Precedence:
# DEEPL_API_KEYS env > DEEPL_API_KEY env > [deepl].api_keys > [deepl].api_key.
DEEPL_API_KEY=YOUR_VALUE_HERE
TELEGRAM_TOKEN=YOUR_VALUE_HERE
TELEGRAM_CHAT_ID=YOUR_VALUE_HERE
TARIFF_DB_PATH=data/tariff.db
# Shipment attachment bytes: gridfs (default) or explicit legacy drive_shared.
# Unknown values fail closed; this is not a secret.
ATTACHMENT_STORAGE_BACKEND=gridfs
# Google Drive attachment store (optional drive_shared backend) —
# server-side only, never exposed to the browser.
# SERVICE_ACCOUNT_STORAGE_MODE=SHARED_DRIVE_ONLY: service accounts have no Drive
# storage quota and cannot own files, so GOOGLE_DRIVE_ROOT_FOLDER_ID must be a
# WRITABLE FOLDER INSIDE A GOOGLE WORKSPACE SHARED DRIVE (the service account's
# client_email needs write permission on that Shared Drive/folder). A normal My
# Drive folder shared with the service account is UNSUPPORTED for this mode.
# Without an available Shared Drive: LIVE_DRIVE_VERIFICATION=BLOCKED.
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_VALUE_HERE
GOOGLE_SERVICE_ACCOUNT_JSON=YOUR_VALUE_HERE
